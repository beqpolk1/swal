<div class="entry_card">
    <div class="entry_card_starred_ind starred_ind {{'starred' if entry.is_starred else ''}}">
        {{ '★' if entry.is_starred else '☆' }}
    </div>

    <div class="entry_card_link_wrapper">
        <a class="entry_card_link" href="{{ url_for(endpoint='entries', _id=entry._id, prev=prev_search) }}">
            <div class="entry_card_artwork">
                {% if entry.artwork_file %}
                <img src="{{ macros.media_file(MEDIA_IMG_DIR, entry.artwork_file_name) }}">
                {% else %}
                <img src="{{ macros.static_file(IMG_STATIC_DIR, DEFAULT_ART) }}">
                {% endif %}
            </div>
        
            <div class="entry_card_title">
                <div class="entry_card_title_artist">
                    <span class="entry_emph_1">{{ entry.artist }}</span>
                </div>

                <div class="entry_card_title_album">
                    <span class="entry_emph_2">{{ entry.album }}</span>
                </div>
            </div>
        </a>
    </div>

    <div class="entry_card_genre">
        {% if entry.genre is not none %}
        {{ entry.genre }}
        {% else %}
        <span class="none_field">Genre</span>
        {% endif %}
    </div>

    <div class="entry_card_release_year">
        {{ entry.release_year }}
    </div>

    <div class="entry_card_interest_level">
        {% if entry.interest_level is not none %}
        {{ entry.interest_level }}
        {% else %}
        <span class="none_field">Interest</span>
        {% endif %}
    </div>

    <div class="entry_card_link {{'has_link' if entry.link is not none else ''}}">
        {% if entry.link is not none %}
        <a href="{{entry.link}}" target="_blank">↗</a>
        {% else %}
        ↗
        {% endif %}
    </div>
</div>