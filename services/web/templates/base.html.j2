{% import "macros.html.j2" as macros %}
<!DOCTYPE html>
<html lang="en">

<head>
    {% block head %}
    <link rel="stylesheet" type="text/css" href="{{ macros.static_file(CSS_STATIC_DIR, 'styles.css') }}">
    <link rel="icon" type="image/x-icon" href="{{ macros.static_file(IMG_STATIC_DIR, 'favicon.ico') }}">
    <title>{% block title %}{% endblock %}</title>
    {% block scripts %}{% endblock %}
    {% endblock %}
</head>

<body>
    {% block body %}
        <div class="content">
            {% block content %}{% endblock %}
        </div>
    {% endblock %}
</body>

</html>