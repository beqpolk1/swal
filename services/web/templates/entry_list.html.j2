{% extends "base.html.j2" %}

{% block title %}SWaL - Entry List{% endblock %}

{% block scripts %}
{% endblock %}

{% block body %}
    {% include 'std_head.html.j2' %}
    {{ super() }}
{% endblock %}

{% block content %}
    <div class="search_bar">
        [build search features here]
    </div>

    {% if not data.has_errors() %}

    <div class="entry_card_list">
        {% for entry in data.get_results() %}
        {% include "entry_card.html.j2" %}
        {% endfor %}
    </div>

    <div class="pagination">
        {% if data.pages["prev"] is not none %}
        <a href="{{ url_for(endpoint='entries', limit=data.pages['limit'], index=data.pages['prev'], **data.pages['addl']) }}">[prev page]</a>
        {% endif %}

        {% if data.pages["next"] is not none %}
        <a href="{{ url_for(endpoint='entries', limit=data.pages['limit'], index=data.pages['next'], **data.pages['addl']) }}">[next page]</a>
        {% endif %}
        
        {% if data.pages["prev"] is none and data.pages["next"] is none%}
        [no pages]
        {% endif %}
    </div>

    {% else %}
    Encountered errors while searching:
    <ul>
        {% for error in data.errors %}
        <li>{{ error }}</li>
        {% endfor %}
    </ul>
    {% endif %}
    
{% endblock %}
