{% extends "base.html.j2" %}

{% block title %}SWaL - {{id}}{% endblock %}

{% block scripts %}
{% endblock %}

{% block body %}
    {% include 'std_head.html.j2' %}
    {{ super() }}
{% endblock %}

{% block content %}
    Just entry {{ id }}
    <br />
    {{ data }}
    <br />
    {% if "errors" in data%}
    Encountered errors while searching:
    <ul>
        {% for error in data["errors"] %}
        <li>{{ error }}</li>
        {% endfor %}
    </ul>
    {% endif %}
{% endblock %}
